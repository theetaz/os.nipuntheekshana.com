{
  "name": "os.nipuntheekshana.com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Serendib OS: the desktop-in-the-browser site of Nipun Theekshana.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/preview-static.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "sync-content": "node scripts/sync-content.mjs",
    "icons": "node scripts/build-icons.mjs",
    "og": "node scripts/build-og.mjs",
    "quality": "npm run check && npm run build && npm run test && npm run budgets",
    "deploy": "npm run build && wrangler deploy",
    "postcards:admin": "node scripts/postcards-admin.mjs",
    "dev:worker": "node scripts/postcards-dev.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/shrikhand": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "jotai": "3.0.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "obscenity": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
