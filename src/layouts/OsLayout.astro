---
import { Font } from 'astro:assets';
import SkipLinks from '../components/static/SkipLinks.astro';
import IconSprite from '../components/static/IconSprite.astro';
import Wallpaper from '../components/static/Wallpaper.astro';
import SimpleChrome from '../components/static/SimpleChrome.astro';
import Desktop from '../os/Desktop';
import type { AppId } from '../os/types/apps';
import { CODENAME, VERSION } from '../os/config';
import { links, now } from '../data/profile';
import type { Seo } from '../lib/seo';
import '../styles/global.css';
import '../styles/static-window.css';

interface Props {
  seo: Seo;
  initial: { appId: AppId; route: string } | null;
  home?: boolean;
}

const { seo, initial } = Astro.props;
const build = { version: VERSION, codename: CODENAME, sha: import.meta.env.PUBLIC_BUILD_SHA ?? 'local', date: new Date().toISOString() };
const ogImage = new URL(seo.ogImage ?? '/og.png', Astro.site ?? 'https://os.nipuntheekshana.com');
const ogType = seo.jsonLd?.some((entry) => '@type' in entry && entry['@type'] === 'BlogPosting') ? 'article' : 'website';
// Escape HTML delimiters so content cannot terminate a JSON-LD script element.
const serializeJsonLd = (entry: object) => JSON.stringify(entry).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="no-js" data-mode="desktop">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        var d = document.documentElement, s = null;
        try { s = window.localStorage; } catch (e) {}
        function get(k) { try { var v = s && s.getItem('serendib:' + k); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
        var themePref = get('theme') || 'auto';
        var dark = themePref === 'dark' || (themePref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
        d.dataset.theme = dark ? 'dark' : 'light';
        d.dataset.wallpaper = get('wallpaper') || 'galle-face';
        d.dataset.accent = get('accent') || 'thambili';
        var motion = get('motion') || 'system';
        if (motion === 'reduce' || motion === 'full') d.dataset.motion = motion;
        if (get('transparency') === 'reduce') d.dataset.transparency = 'reduce';
        if (get('view') === 'simple') d.dataset.view = 'simple';
        var mobile = matchMedia('(max-width: 1023px), (pointer: coarse) and (max-width: 1179px)').matches;
        d.dataset.mode = mobile ? 'mobile' : 'desktop';
        d.classList.remove('no-js'); d.classList.add('js');
        var reduce = motion === 'reduce' || (motion !== 'full' && matchMedia('(prefers-reduced-motion: reduce)').matches);
        if (location.pathname === '/' && !get('booted') && !reduce && d.dataset.view !== 'simple' &&
            location.hash !== '#simple' && !/bot|crawl|spider|slurp/i.test(navigator.userAgent)) d.dataset.boot = '1';
      })();
    </script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Serendib OS" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="theme-color" content="#F4E3CC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1520" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="me" href={links.github} />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-fraunces" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-martian" />
    {seo.jsonLd?.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
  </head>
  <body>
    <span id="simple" aria-hidden="true"></span>
    <SkipLinks />
    <IconSprite />
    <Wallpaper />
    <SimpleChrome>
      <main id="content" tabindex="-1"><slot /></main>
      <Desktop client:load initial={initial} build={build} home={{ nowItems: now.items, nowUpdated: now.updated }} />
      <slot name="after-main" />
    </SimpleChrome>
  </body>
</html>
