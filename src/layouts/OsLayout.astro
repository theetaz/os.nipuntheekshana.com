---
import { Font } from 'astro:assets';
import SkipLinks from '../components/static/SkipLinks.astro';
import IconSprite from '../components/static/IconSprite.astro';
import Hero from '../components/kottu/Hero.astro';
import HeroPreloads from '../components/kottu/HeroPreloads.astro';
import Story from '../components/story/Story.astro';
import { propArt } from '../lib/kottu-art';
import Wallpaper from '../components/static/Wallpaper.astro';
import SimpleChrome from '../components/static/SimpleChrome.astro';
import Desktop from '../os/Desktop';
import { HomeScreen } from '../os/mobile/HomeScreen';
import type { AppId } from '../os/types/apps';
import { CODENAME, VERSION } from '../os/config';
import { links, now } from '../data/profile';
import type { Seo } from '../lib/seo';
import '../styles/global.css';

interface Props {
  seo: Seo;
  initial: { appId: AppId; route: string } | null;
  home?: boolean;
  story?: boolean;
}

const { seo, initial, home = false, story = true } = Astro.props;
const [tuktuk, lotusTower, tea, radio] = await Promise.all([propArt('prop-tuktuk'), propArt('prop-lotus-tower'), propArt('prop-tea'), propArt('prop-radio')]);
const art = { tuktuk, 'lotus-tower': lotusTower, tea, radio };
const build = { version: VERSION, codename: CODENAME, sha: import.meta.env.PUBLIC_BUILD_SHA ?? 'local', date: new Date().toISOString() };
const ogImage = new URL(seo.ogImage ?? '/og.png', Astro.site ?? 'https://os.nipuntheekshana.com');
const ogType = seo.jsonLd?.some((entry) => '@type' in entry && entry['@type'] === 'BlogPosting') ? 'article' : 'website';
// Escape HTML delimiters so content cannot terminate a JSON-LD script element.
const serializeJsonLd = (entry: object) => JSON.stringify(entry).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="no-js" data-mode="desktop">
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <meta name="turnstile-site-key" content={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} />}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>(function(){var e=document.documentElement,d=null;try{d=window.localStorage}catch{}function t(c){try{var l=d&&d.getItem("serendib:"+c);return l?JSON.parse(l):null}catch{return null}}var o=t("theme")||"auto",n=o==="dark"||o==="auto"&&matchMedia("(prefers-color-scheme: dark)").matches;e.dataset.theme=n?"dark":"light";var i=t("wallpaper");e.dataset.wallpaper=["kottu","galle-face","pettah","paper"].includes(i)?i:"kottu";var r=t("props:v1");if(r)for(var a in r)/^[a-z-]+$/.test(a)&&r[a]&&(e.style.setProperty("--k-dx-"+a,+r[a].dx||0),e.style.setProperty("--k-dy-"+a,+r[a].dy||0));e.dataset.accent=t("accent")||"thambili";var s=t("motion")||"system";(s==="reduce"||s==="full")&&(e.dataset.motion=s),t("transparency")==="reduce"&&(e.dataset.transparency="reduce"),t("view")==="simple"&&(e.dataset.view="simple");var m=matchMedia("(max-width: 1023px), (pointer: coarse) and (max-width: 1179px)").matches;e.dataset.mode=m?"mobile":"desktop",e.classList.remove("no-js"),e.classList.add("js");var p=s==="reduce"||s!=="full"&&matchMedia("(prefers-reduced-motion: reduce)").matches;location.pathname==="/"&&!t("booted")&&!p&&e.dataset.view!=="simple"&&location.hash!=="#simple"&&!/bot|crawl|spider|slurp/i.test(navigator.userAgent)&&(e.dataset.boot="1")})();</script>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kottu OS" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="theme-color" content="#0FA3A3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B1530" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="me" href={links.github} />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-shrikhand" preload />
    <Font cssVariable="--font-kalam" />
    <Font cssVariable="--font-fraunces" />
    <HeroPreloads />
    <Font cssVariable="--font-martian" />
    {seo.jsonLd?.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
  </head>
  <body>
    <span id="simple" aria-hidden="true"></span>
    <SkipLinks />
    <IconSprite />
    <Wallpaper />
    <SimpleChrome>
      <Hero home={home} />
      <main id="content" tabindex="-1"><slot /></main>
      <div id="static-phone-home" class="os-chrome"><HomeScreen art={art} home={{ nowItems: now.items, nowUpdated: now.updated }} /></div>
      {story && <Story nosnippet={!home} />}
      <Desktop client:paint initial={initial} build={build} home={{ nowItems: now.items, nowUpdated: now.updated }} />
      <slot name="after-main" />
    </SimpleChrome>
  </body>
</html>
