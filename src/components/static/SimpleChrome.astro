---
import { APP_META } from '../../os/registry/meta';
import StaticTopBar from './StaticTopBar.astro';
import StaticLauncher from './StaticLauncher.astro';
import '../../styles/simple-view.css';
const apps = Object.values(APP_META).filter((app) => app.phase === 'v1');
---
<StaticTopBar />
<header class="simple-header simple-only"><a class="simple-wordmark" href="/#simple">kottu</a><a href={Astro.url.pathname} data-simple-back>Back to the desktop</a></header>
<slot />

<StaticLauncher />
<footer class="simple-footer simple-only"><nav aria-label="All sections"><a href="/#simple">Home</a>{apps.map((app) => <a href={`${app.basePath}#simple`}>{app.name}</a>)}<a href="/maps/play#simple">Pin the city</a></nav><p>Made in Colombo, Sri Lanka.</p></footer>

<script is:inline>
  document.addEventListener('click',e=>{var l=e.target?.closest?.('[data-simple-back]'),h=document.documentElement;if(l&&!h.classList.contains('os-ready')&&!e.defaultPrevented&&e.button===0&&!e.metaKey&&!e.ctrlKey&&!e.shiftKey&&!e.altKey){e.preventDefault();h.dataset.viewRequest='desktop';}});
</script>
