---
import { APP_ICON_SYMBOLS } from '../../os/icons/app-icons';
// Keep local symbol ids and use references; share the drawing bytes across pages.
const ids = Object.keys(APP_ICON_SYMBOLS);
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  {ids.map(id => <symbol id={id}><use href={`/app-icons.svg#${id}`} /></symbol>)}
</svg>
