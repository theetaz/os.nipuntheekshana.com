---
import { SheetHeader } from '../../os/mobile/SheetHeader';
import { APP_META } from '../../os/registry/meta';
import type { AppId } from '../../os/types/apps';
import '../../styles/static-window.css';
interface Props { app: AppId; route?: string; query?: Record<string, string>; title?: string; adoptable?: boolean; scrollRoot?: 'content' | 'app' }
const { app, route = '', query = {}, title = APP_META[app].name, adoptable = true, scrollRoot = 'content' } = Astro.props;
const { width, height } = APP_META[app].window;
---
<section id={adoptable ? 'static-window' : 'static-alert'} class="static-window" data-app={adoptable ? app : undefined} data-theme={app === 'terminal' ? 'dark' : undefined} data-route={route} data-query={JSON.stringify(query)} role="dialog" aria-modal="false" aria-labelledby="static-window-title" style={`--window-width:${width}px;--window-height:${height}px`}>
  <span class="k-ring" aria-hidden="true"><i /></span>
  <SheetHeader appId={app} route={route} title={title} />
  <header class="static-titlebar" data-titlebar={adoptable ? APP_META[app].window.titleBar : 'standard'}>
    <span id="static-window-title" aria-label={app === 'terminal' ? 'Terminal' : undefined}>{title}</span>
    <div class="k-winbtns" role="group" aria-label="Window controls">
      <button class="k-winbtn js-only" data-window-button="minimise" disabled aria-label="Minimise (available in the interactive desktop)"><span class="k-winbtn-disc"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M2 5h6" /></svg></span></button>
      <button class="k-winbtn js-only" data-window-button="maximise" disabled aria-label="Maximise (available in the interactive desktop)"><span class="k-winbtn-disc"><svg viewBox="0 0 10 10" aria-hidden="true"><rect x="2" y="2" width="6" height="6" /></svg></span></button>
      <a class="k-winbtn" data-window-button="close" href="/" aria-label="Close (back to the desktop)"><span class="k-winbtn-disc"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="m2 2 6 6M8 2 2 8" /></svg></span></a>
    </div>
  </header>
  <div class="static-content" data-scroll-root={scrollRoot === 'content' ? '' : undefined} tabindex={scrollRoot === 'content' ? 0 : undefined}><div class="static-document"><slot /></div></div>
</section>
