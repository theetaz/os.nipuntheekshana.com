---
import '../../styles/wallpapers.css';
import skyline from '../../assets/wallpapers/skyline.svg?raw';
---
<div class="wallpaper os-chrome" aria-hidden="true">
  <div class="wp-layer wp-sky"></div><div class="wp-layer wp-rays"></div><div class="wp-layer wp-dots"></div>
  <div class="wp-layer wp-sun"></div><div class="wp-layer wp-sea"></div><div class="wp-layer wp-skyline" set:html={skyline}></div>
</div>
