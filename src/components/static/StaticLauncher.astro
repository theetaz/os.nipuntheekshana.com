---
import { APP_META, DOCK_LINKS } from '../../os/registry/meta';
const apps = Object.values(APP_META).filter(app => app.phase === 'v1' && (app.id !== 'guestbook' || !!import.meta.env.PUBLIC_TURNSTILE_SITE_KEY));
const dockApps = apps.filter(app => app.dockOrder !== null && app.id !== 'trash').sort((a, b) => a.dockOrder! - b.dockOrder!);
---
<nav class="static-dock os-chrome" aria-label="Dock"><ul>
  {dockApps.map((app) => <li class:list={[{ 'desktop-only': app.mobile.dockOrder === null }]}><a href={app.basePath} aria-label={app.name}><svg width="48" height="48" viewBox="0 0 64 64" aria-hidden="true"><use href={`#${app.icon}`} /></svg></a></li>)}
  <li class="dock-divider desktop-only" aria-hidden="true"></li>
  {DOCK_LINKS.map((link) => <li class="desktop-only"><a href={link.href} aria-label={link.label}><svg width="48" height="48" viewBox="0 0 64 64" aria-hidden="true"><use href={`#${link.icon}`} /></svg></a></li>)}
  <li class="dock-divider desktop-only" aria-hidden="true"></li><li class="desktop-only"><a href="/kooda" aria-label="Kooda"><svg width="48" height="48" viewBox="0 0 64 64" aria-hidden="true"><use href="#app-trash" /></svg></a></li>
</ul></nav>
