---
import ProjectCard from './ProjectCard.astro';
import SectionHead from './SectionHead.astro';
import { storyProjects, type StorySectionId } from '../../lib/story-projects';
const projects = await storyProjects();
const sections: { id: string; section: StorySectionId; title: string; command: string; subtitle: string }[] = [
  { id: 'ws-projects', section: 'highlights', title: 'Highlights', command: 'ls --highlights', subtitle: "the ones I'd show my amma first" },
  { id: 'k-side', section: 'side', title: 'Side projects', command: 'ls side-projects/', subtitle: 'built on weekends, powered by kiribath' },
  { id: 'k-fun', section: 'fun', title: 'Fun stuff', command: 'ls fun/', subtitle: 'games, gadgets and one very round character' },
];
---
{sections.map(({ id, section, title, command, subtitle }) => <section id={id} class="k-sec" data-sec={section} aria-labelledby={`${id}-title`}>
  <div class="k-sec-shape" aria-hidden="true"></div>
  <div class="k-sec-inner">
    <SectionHead id={id} title={title} command={command} subtitle={subtitle} path="~/projects" />
    <div class="k-sec-content" data-k-cards={section}>{projects[section].map(project => <ProjectCard project={project} variant={section === 'highlights' ? 'highlight' : 'standard'} section={section} />)}</div>
  </div>
</section>)}
