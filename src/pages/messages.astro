---
import OsLayout from '../layouts/OsLayout.astro';
import StaticWindow from '../components/static/StaticWindow.astro';
import InitialData from '../components/static/InitialData.astro';
import { APP_META } from '../os/registry/meta';
import { seoFor } from '../lib/seo';
import { getClientProfile } from '../lib/client-data';
import { initialTranscript } from '../os/apps/messages/script';
import { MessagesView } from '../os/apps/messages/views/MessagesView';

const seo = seoFor({ path: '/messages', title: 'Messages', description: APP_META.messages.description, kind: 'app' });
const profile = { ...await getClientProfile(), messagesAt: Date.now() };
const threads = { nipun: initialTranscript(profile, profile.messagesAt), mochi: [] };
---
<OsLayout seo={seo} initial={{ appId: 'messages', route: '' }}>
  <StaticWindow app="messages" route="" title="Messages">
    <MessagesView profile={profile} selected="nipun" threads={threads} />
  </StaticWindow>
  <InitialData slot="after-main" key="messages:index" data={profile} />
</OsLayout>
