---
import OsLayout from '../layouts/OsLayout.astro';
import StaticWindow from '../components/static/StaticWindow.astro';
import { APP_META } from '../os/registry/meta';
import { seoFor } from '../lib/seo';
import { site } from '../data/profile';
const seo = seoFor({ path: '/postcards', title: 'Board', description: APP_META.guestbook.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'guestbook', route: '' }}>
  <StaticWindow app="guestbook" route="" title="New note">
    <div class="static-document"><h1>Leave a note</h1>
      <p>Sign the message board with a name and a kind note, up to 300 characters. Keep links off the wall.</p>
      <p>Enable JavaScript to choose a colour and font and pin your note. Your email is optional and never shown on the board.</p>
      <p>You can also <a href={`mailto:${site.email}?subject=Hello%20from%20Kottu%20OS`}>email Nipun</a>.</p>
      <a href="/#ws-board">Read the message board</a>
    </div>
  </StaticWindow>
</OsLayout>
