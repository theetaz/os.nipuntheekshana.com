---
import OsLayout from '../layouts/OsLayout.astro';
import StaticWindow from '../components/static/StaticWindow.astro';
import InitialData from '../components/static/InitialData.astro';
import { APP_META } from '../os/registry/meta';
import { seoFor } from '../lib/seo';
import { getClientProfile } from '../lib/client-data';
import { AboutView } from '../os/apps/about/views/AboutView';
const profile = { ...await getClientProfile(), renderedAt: new Date().toISOString() };
const seo = seoFor({ path: '/about', title: 'About', description: APP_META.about.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'about', route: '' }}>
  <StaticWindow app="about" route="" title="About" scrollRoot="app">
    <AboutView profile={profile} at={profile.renderedAt} />
  </StaticWindow>
  <InitialData slot="after-main" key="about:index" data={profile} />
</OsLayout>
