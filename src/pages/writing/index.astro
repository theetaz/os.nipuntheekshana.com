---
import OsLayout from '../../layouts/OsLayout.astro';
import StaticWritingWindow from '../../os/apps/writing/views/StaticWritingWindow.astro';
import { WritingView } from '../../os/apps/writing/views/WritingView';
import InitialData from '../../components/static/InitialData.astro';
import { APP_META } from '../../os/registry/meta';
import { seoFor } from '../../lib/seo';
import { getClientPosts } from '../../lib/client-data';
const posts = await getClientPosts();
const seo = seoFor({ path: '/writing', title: 'Writing', description: APP_META.writing.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'writing', route: '' }}>
  <StaticWritingWindow><WritingView posts={posts} post={null} /></StaticWritingWindow>
  <InitialData slot="after-main" key="writing:index" data={{ posts, post: null }} />
</OsLayout>
