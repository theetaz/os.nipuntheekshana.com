---
import OsLayout from '../../layouts/OsLayout.astro';
import StaticWritingWindow from '../../os/apps/writing/views/StaticWritingWindow.astro';
import { WritingView } from '../../os/apps/writing/views/WritingView';
import InitialData from '../../components/static/InitialData.astro';
import { getClientPosts, getClientPost } from '../../lib/client-data';
import { seoFor } from '../../lib/seo';
export async function getStaticPaths() { return (await getClientPosts()).map((post) => ({ params: { slug: post.slug } })); }
const post = (await getClientPost(Astro.params.slug!))!;
const posts = await getClientPosts();
const seo = seoFor({ path: `/writing/${post.slug}`, title: post.title, description: post.description, kind: 'post', post });
---
<OsLayout seo={seo} initial={{ appId: 'writing', route: post.slug }}>
  <StaticWritingWindow route={post.slug} title={`${post.title} — Writing`}>
    <WritingView posts={posts} post={post} route={post.slug} />
  </StaticWritingWindow>
  <InitialData slot="after-main" key={`writing:${post.slug}`} data={{ posts, post }} />
</OsLayout>
