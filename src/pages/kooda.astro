---
import OsLayout from '../layouts/OsLayout.astro';
import StaticWindow from '../components/static/StaticWindow.astro';
import InitialData from '../components/static/InitialData.astro';
import { APP_META } from '../os/registry/meta';
import { seoFor } from '../lib/seo';


const seo = seoFor({ path: '/kooda', title: 'Kooda', description: APP_META.trash.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'trash', route: '' }}>
  <StaticWindow app="trash" route="" title="Kooda">
    <h1>Kooda</h1><p class="lede">{APP_META.trash.description}</p>
    <p>Kooda means basket. The interactive basket needs JavaScript.</p><p><a href="/projects">Explore the projects that made it.</a></p>
  </StaticWindow>
  <InitialData slot="after-main" key="trash" data={{}} />
</OsLayout>
