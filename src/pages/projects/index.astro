---
import OsLayout from '../../layouts/OsLayout.astro';
import ProjectsStaticWindow from '../../os/apps/projects/views/ProjectsStaticWindow.astro';
import { ProjectsIndexView } from '../../os/apps/projects/views/ProjectsIndexView';
import InitialData from '../../components/static/InitialData.astro';
import { APP_META } from '../../os/registry/meta';
import { seoFor } from '../../lib/seo';
import { getClientProjects, getArchive } from '../../lib/client-data';
import { categories } from '../../data/projects';
const [projects, archive] = await Promise.all([getClientProjects(), getArchive()]);
const data = { projects, archive, categories };
const seo = seoFor({ path: '/projects', title: 'Projects', description: APP_META.projects.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'projects', route: '' }}>
  <ProjectsStaticWindow><ProjectsIndexView data={data} selected={projects.find(project => project.category === 'data')?.slug ?? null} /></ProjectsStaticWindow>
  <InitialData slot="after-main" key="projects:index" data={data} />
</OsLayout>
