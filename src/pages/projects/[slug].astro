---
import OsLayout from '../../layouts/OsLayout.astro';
import StaticWindow from '../../components/static/StaticWindow.astro';
import InitialData from '../../components/static/InitialData.astro';
import { getClientProjects, getClientWork } from '../../lib/client-data';
import { seoFor } from '../../lib/seo';
export async function getStaticPaths() { return (await getClientProjects()).map((project) => ({ params: { slug: project.slug } })); }
const projects = await getClientProjects();
const project = projects.find((project) => project.slug === Astro.params.slug)!;
const work = await getClientWork(project.slug);
const following = projects[(projects.indexOf(project) + 1) % projects.length]!;
const next = { slug: following.slug, title: following.title };
const seo = seoFor({ path: `/projects/${project.slug}`, title: project.title, description: project.tagline, kind: 'project', project });
---
<OsLayout seo={seo} initial={{ appId: 'projects', route: project.slug }}>
  <StaticWindow app="projects" route={project.slug} title={`${project.title} — Projects`}>
    <h1>{project.title}</h1><p class="lede">{project.tagline}</p><p>{project.description}</p>
    {work && <><p>{work.lede}</p><p><strong>Role:</strong> {work.role}</p><div set:html={work.html} /></>}
    <p>{project.repo && <a href={project.repo}>Source code</a>}{project.repo && project.live && ' · '}{project.live && <a href={project.live}>Visit project</a>}</p>
    <p><a href="/projects">All projects</a> · <a href={`/projects/${next.slug}`}>Next: {next.title}</a></p>
  </StaticWindow>
  <InitialData slot="after-main" key={`projects:${project.slug}`} data={{ project, work, next }} />
</OsLayout>
