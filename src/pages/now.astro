---
import OsLayout from '../layouts/OsLayout.astro';
import StaticWindow from '../components/static/StaticWindow.astro';
import InitialData from '../components/static/InitialData.astro';
import { APP_META } from '../os/registry/meta';
import { seoFor } from '../lib/seo';
import { getClientProfile } from '../lib/client-data';
import { NowView } from '../os/apps/now/NowView';
const profile = await getClientProfile();
const seo = seoFor({ path: '/now', title: 'Now', description: APP_META.now.description, kind: 'app' });
---
<OsLayout seo={seo} initial={{ appId: 'now', route: '' }}>
  <StaticWindow app="now" route="" title="Now">
    <NowView now={profile.now} />
  </StaticWindow>
  <InitialData slot="after-main" key="now:index" data={profile} />
</OsLayout>
