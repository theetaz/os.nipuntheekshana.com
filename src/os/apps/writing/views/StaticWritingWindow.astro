---
import { SheetHeader } from '../../../mobile/SheetHeader';
import { APP_META } from '../../../registry/meta';
import '../../../../styles/static-window.css';
interface Props { route?: string; title?: string }
const { route = '', title = 'Writing' } = Astro.props;
const { width, height } = APP_META.writing.window;
---
<!-- A direct content slot lets adoption copy the active pane's scroll root. -->
<section id="static-window" class="static-window writing-static-window" data-app="writing" data-route={route} data-query="{}" role="dialog" aria-modal="false" aria-labelledby="static-window-title" style={`--window-width:${width}px;--window-height:${height}px`}>
  <SheetHeader appId={"writing"} route={route} title={title} />
  <header class="static-titlebar">
    <div class="traffic-lights">
      <a class="traffic-light close" data-traffic-light href="/" aria-label="Close (back to the desktop)"><span aria-hidden="true">×</span><span class="mobile-home" aria-hidden="true">Home</span></a>
      <button class="traffic-light minimise js-only" data-traffic-light disabled aria-label="Minimise (available in the interactive desktop)"><span aria-hidden="true">−</span></button>
      <button class="traffic-light zoom js-only" data-traffic-light disabled aria-label="Zoom (available in the interactive desktop)"><span aria-hidden="true">+</span></button>
    </div>
    <span id="static-window-title">{title}</span>
  </header>
  <slot />
</section>
