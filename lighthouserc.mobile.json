{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --ignore-lock",
      "startServerReadyPattern": "localhost:4357",
      "url": [
        "http://localhost:4357/",
        "http://localhost:4357/projects/salli",
        "http://localhost:4357/writing/an-island-made-of-points",
        "http://localhost:4357/maps"
      ],
      "numberOfRuns": 3,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 250 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/mobile" }
  }
}
