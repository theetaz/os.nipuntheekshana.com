{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --ignore-lock",
      "startServerReadyPattern": "localhost:4321",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/projects/salli",
        "http://localhost:4321/writing/an-island-made-of-points",
        "http://localhost:4321/maps"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/desktop" }
  }
}
