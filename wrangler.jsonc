{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Replace the local placeholder IDs after provisioning, before deployment.
  "name": "serendib-os",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "serendib", "database_id": "00000000-0000-0000-0000-000000000007", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "PERSONA", "id": "00000000000000000000000000000007" }],
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    { "name": "RL_POSTCARDS", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_MESSAGES", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_MAX_TOKENS": "400",
    "AI_DAILY_LIMIT_PER_IP": "40",
    "AI_DAILY_LIMIT_GLOBAL": "2000",
    "AI_MESSAGES_ENABLED": "false",
    "TURNSTILE_SITE_KEY": ""
  },
  "routes": [{ "pattern": "os.nipuntheekshana.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
